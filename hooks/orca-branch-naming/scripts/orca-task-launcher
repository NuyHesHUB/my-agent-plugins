#!/usr/bin/env bash
# orca-task launcher — 설치된 orca-branch-naming 플러그인의 scripts/orca-task 를 찾아 실행한다.
# 플러그인이 업데이트돼 경로가 바뀌어도 installed_plugins.json 에서 최신 경로를 읽는다.
set -euo pipefail
root=$(python3 -I - <<'PY' 2>/dev/null || true
import json, os
d = json.load(open(os.path.expanduser("~/.claude/plugins/installed_plugins.json")))
for k, v in d.get("plugins", {}).items():
    if k.startswith("orca-branch-naming@") and v:
        print(v[0]["installPath"]); break
PY
)
[ -n "$root" ] && [ -f "$root/scripts/orca-task" ] || { echo "orca-task: orca-branch-naming 플러그인이 설치돼 있지 않습니다. Claude Code 세션에서 /plugin install orca-branch-naming@nuyheshub 로 설치하세요." >&2; exit 1; }
exec bash "$root/scripts/orca-task" "$@"

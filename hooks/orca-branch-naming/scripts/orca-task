#!/usr/bin/env bash
# orca-task — 작업 프롬프트로 이름을 먼저 짓고, 그 이름으로 Orca 워크스페이스를 생성한다.
#
# UI에서 "이름 비우고 생성 → 랜덤 이름 → 첫 프롬프트에서 훅이 교정" 하던 흐름을 뒤집어,
# 생성 시점부터 폴더·브랜치·표시 이름이 전부 <type>/<slug> 컨벤션이 되게 한다.
# (브랜치에 / 가 있으므로 orca-branch-naming 훅은 자동으로 개입하지 않는다.)
#
# 사용:
#   orca-task "로그인 폼 버그 고쳐줘"                       # 현재 Orca 컨텍스트의 repo에 생성
#   orca-task --repo name:intube-cms-fe "회원가입 폼 버그"   # repo 지정
#   orca-task --agent codex "..."                            # 다른 에이전트
#   orca-task --dry-run "..."                                # 이름만 생성해보고 생성은 안 함
#   그 외 --base-branch, --setup, --no-parent 등은 orca worktree create 에 그대로 전달
set -euo pipefail

orca_bin="${ORCA_CLI_COMMAND:-orca-ide}"
agent=claude
name_model="${ORCA_TASK_NAME_MODEL:-haiku}"
dry_run=
prompt=
pass=()

while [ $# -gt 0 ]; do
  case "$1" in
    --agent)      agent=$2; shift 2 ;;
    --name-model) name_model=$2; shift 2 ;;
    --dry-run)    dry_run=1; shift ;;
    --no-parent|--activate|--run-hooks|--json)
                  pass+=("$1"); shift ;;
    --*)          pass+=("$1" "${2:?orca-task: $1 뒤에 값이 필요합니다}"); shift 2 ;;
    *)            if [ -n "$prompt" ]; then echo "orca-task: 프롬프트는 하나만 받습니다 (따옴표로 감싸세요)" >&2; exit 1; fi
                  prompt=$1; shift ;;
  esac
done

[ -n "$prompt" ] || { echo "사용법: orca-task [옵션] \"작업 프롬프트\"" >&2; exit 1; }

types='feat|fix|refactor|chore|test|docs|style|perf|ci|build'

gen=$(claude -p "다음 작업 요청을 보고 git 브랜치명을 지어라. 정확히 두 줄만 출력한다.
1번째 줄: <type>/<slug>  — type 은 ${types//|/, } 중 하나. slug 는 영문 소문자 kebab-case 2~4단어, 최대 32자, 화면/도메인+동작 조합.
2번째 줄: 작업 한 줄 요약 (한국어).
코드블록·설명 등 다른 텍스트는 출력하지 마라.

작업 요청: $prompt" --model "$name_model" 2>/dev/null) || {
  echo "orca-task: 이름 생성 실패 — claude 호출이 실패했습니다. claude 로그인/네트워크를 확인하세요." >&2; exit 1; }

name=$(printf '%s\n' "$gen" | sed -n 1p | tr -d ' \r`')
summary=$(printf '%s\n' "$gen" | sed -n 2p | sed 's/\r$//')

if ! [[ "$name" =~ ^(feat|fix|refactor|chore|test|docs|style|perf|ci|build)/[a-z0-9][a-z0-9-]{0,31}$ ]]; then
  echo "orca-task: 생성된 이름이 형식에 맞지 않습니다: '$name'" >&2
  echo "          다시 실행하거나 --name-model 로 다른 모델을 지정해보세요." >&2
  exit 1
fi

echo "이름: $name"
[ -n "$summary" ] && echo "요약: $summary"

if [ -n "$dry_run" ]; then
  echo "(--dry-run: 워크스페이스는 생성하지 않았습니다)"
  exit 0
fi

out=$("$orca_bin" worktree create --name "$name" --agent "$agent" --prompt "$prompt" \
      --comment "${summary:-$name}" --activate --json "${pass[@]}") || {
  echo "orca-task: 워크스페이스 생성 실패 (아무것도 만들어지지 않았습니다)" >&2
  printf '%s\n' "$out" >&2
  exit 1
}

path=$(printf '%s' "$out" | python3 -I -c 'import json,sys
try:
    d=json.load(sys.stdin); w=d.get("result",{}).get("worktree",{})
    print(w.get("path") or "")
except Exception:
    print("")' 2>/dev/null) || path=""

# Orca 는 --name 의 / 를 - 로 치환해 브랜치를 만들므로, 브랜치를 슬래시 컨벤션으로 직접 맞춘다.
# (claude 에이전트면 orca-branch-naming 훅이 첫 프롬프트에서 해주지만, codex 등 훅이 없는
#  에이전트에서도 동일하게 보장한다. 이미 맞으면 건너뛴다.)
lpath=$(wslpath -u "$path" 2>/dev/null || true)
if [ -n "$lpath" ] && [ -d "$lpath" ]; then
  cur=$(git -C "$lpath" branch --show-current 2>/dev/null || true)
  if [ -n "$cur" ] && [ "$cur" != "$name" ]; then
    git -C "$lpath" branch -m "$name" 2>/dev/null && echo "브랜치: $cur → $name" || true
  fi
fi

echo "생성 완료: ${path:-$name} (에이전트 $agent 가 프롬프트를 받아 시작했습니다)"
echo "롤백: $orca_bin worktree rm --worktree branch:$name --force --json"
